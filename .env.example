# Local defaults. The server does not automatically load this file.
HOST=127.0.0.1
PORT=4173

# Required for public deployments. Replace with a long random secret in the
# hosting platform; never commit the real value.
POSTER_LAB_ADMIN_TOKEN=replace-with-a-long-random-secret

# Use a mounted persistent disk path in production.
POSTER_LAB_DATA_FILE=server/data.json

# Leave empty for same-origin frontend + API deployments.
CORS_ORIGIN=
